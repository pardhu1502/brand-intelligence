# --- Search tool ---
TAVILY_API_KEY=

# --- LLM provider: groq | openai | anthropic | gemini | ollama ---
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant

# Provide the key for whichever provider you set above
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Bonus: route the extraction sub-task through a local Ollama model ---
OLLAMA_EXTRACTION=false
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# --- Agent tuning ---
MAX_SEARCH_ROUNDS=2
MIN_SUCCESSFUL_EXTRACTIONS=3
MAX_LINKS_PER_ROUND=5
